{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["packages/domain/src/index.ts", "tests/**/*.spec.ts"],
  "project": ["packages/domain/src/**/*.ts"],
  "ignore": ["tools/**", "dist/**", "build/**"],
  "ignoreBinaries": ["biome", "depcruise", "grype", "lizard"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@cyclonedx/cdxgen", "@stryker-mutator/core", "@stryker-mutator/mocha-runner",
    "npm-check-updates", "jscpd", "madge", "dependency-cruiser", "ts-prune",
    "@biomejs/biome", "c8", "nyc", "espree", "eslint-scope", "source-map-support",
    "esbuild", "vite", "rollup", "ts-morph", "knip", "vitest", "@vitest/coverage-v8",
    "@opentelemetry/api", "@opentelemetry/sdk-node", "@opentelemetry/sdk-trace-base",
    "@types/lodash", "@types/minimist", "@types/node-fetch", "@types/tar",
    "@types/node", "@types/mocha", "@types/chai"
  ]
}
